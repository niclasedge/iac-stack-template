# secrets/example.env: the documentation of what secrets/app.env contains.
#
# PLACEHOLDERS ONLY. This file is committed in plaintext on purpose and must
# never hold a real value. To create your real secrets:
#
#   cp secrets/example.env secrets/app.env
#   sops --encrypt --in-place secrets/app.env     # then edit with: just secrets-edit
#
# See docs/secrets.md. Keys that a recipe or playbook reads are listed with the
# component that needs them.

# -- Alerting: monitor-check.py (GitHub Issues) --------------------------------
# A token that may create and close issues in GITHUB_OWNER/GITHUB_REPO.
GITHUB_TOKEN=replace-me
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=your-alerts-repo

# -- Elasticsearch (read by monitor-check.py and the es_logger callback) -------
# IAC_ES_URL lets the es_logger callback post run spans straight to Elasticsearch.
ES_URL=http://127.0.0.1:9200
IAC_ES_URL=http://127.0.0.1:9200

# -- Dead man's switch (Healthchecks or compatible) ----------------------------
HEALTHCHECKS_URL=https://hc-ping.com

# -- Inventory (ansible/inventory/inventory.example.yml reads these) -----------
EDGE_VPS_HOST=192.0.2.10
EDGE_VPS_USER=deploy
SSH_KEY_EDGE_VPS=~/.ssh/id_ed25519
HOME_SERVER_HOST=10.0.0.20
HOME_SERVER_USER=deploy
SSH_KEY_HOME_SERVER=~/.ssh/id_ed25519
# Only if the user needs a sudo password on that host (prefer passwordless sudo
# for the deploy user and leave this out).
HOME_SERVER_BECOME_PASS=replace-me

# -- Service secrets referenced from services.yml (env_from_secrets) -----------
MINIFLUX_DB_PASSWORD=replace-me
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=replace-me
