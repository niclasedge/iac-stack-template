# Secrets. The source of truth is `secrets/app.env`, encrypted with SOPS + age
# and committed once YOU created it: that is the design, so nothing here may
# match it. `.env` and `.env.*` are patterns without a slash, so they match a
# file of that name in any directory but never `secrets/app.env`.
.env
.env.*
!.env.example
!secrets/*.env
# Anything a decrypt was accidentally redirected into. `just secrets-view`
# prints to stdout for exactly this reason: there is no supported way to write
# the plaintext to disk, and a file like this is always a mistake.
*.decrypted
*.plaintext
# `.env.j2` is a service's .env TEMPLATE and must be versioned: roles/
# service_deploy/tasks/env-file.yml renders it on the host, once. Ignored, it
# silently vanishes from a fresh clone and the role's "no template found" branch
# treats that as success. A template that contains a literal secret is the bug.
!.env.j2

# Your real inventory: hostnames, IPs and users of YOUR machines. Copy
# ansible/inventory/inventory.example.yml to inventory.yml and keep it local.
ansible/inventory/inventory.yml
ansible/inventory/*.local.yml
ansible/inventory/host_vars/
ansible/inventory/group_vars/*/local.yml

# Per-service job-to-Healthchecks mapping (check UUIDs): local, not committed.
monitoring/config/healthcheck_uuids.json

# Logs
monitoring/logs/
/logs/
**/*.log

# Runtime state (generated by monitor-check)
*.state

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
*.egg-info/

# Ansible
*.retry

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
